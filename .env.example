# Hormiga — variables de entorno para DESARROLLO (copia a .env y rellena).
# En la app empaquetada estas credenciales se introducen desde Ajustes → Cuenta de correo
# y se guardan cifradas con el almacén seguro del sistema (DPAPI en Windows).
#
# Cliente OAuth 2.0 de tipo "Aplicación de escritorio" de tu propio proyecto de Google Cloud.
# El secreto de un cliente de escritorio no es confidencial según Google, pero no lo subas a Git.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Nivel de log: error | warn | info | debug (por defecto info en producción, debug en desarrollo)
HORMIGA_LOG_LEVEL=
